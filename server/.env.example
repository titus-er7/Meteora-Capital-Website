# Copy to .env (never commit it) and fill in. Generate SECRET_KEY with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The site's public address. Used for links in emails (never the request's
# Host header) and as an allowed origin for form posts.
PUBLIC_BASE_URL=https://meteoracapital.com

# Any other origins allowed to post forms, comma-separated.
ALLOWED_ORIGINS=https://www.meteoracapital.com

# Set to false only for local development over http.
COOKIE_SECURE=true

# Number of reverse proxies in front of the app (for client IPs and https).
TRUSTED_PROXIES=1

# How long an investor stays signed in.
SESSION_HOURS=12

# Access requests per IP per 10 minutes; sign-in attempts per IP per 15 minutes.
REQUEST_LIMIT=5
LOGIN_LIMIT=10

# SQLite file holding investors and attestation records (back this up).
DATABASE_PATH=

# Email is required: approvers get review links and investors get password
# links. Leaving SMTP_HOST empty only prints emails to the log (development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=website@meteoracapital.com
# Approvers who receive the review links, comma-separated.
MAIL_TO=kevin@meteoracapital.com

# DocSend links shown to signed-in, approved investors.
DOCSEND_DECK_URL=https://docsend.com/view/REPLACE-DECK
DOCSEND_TEARSHEET_URL=https://docsend.com/view/REPLACE-TEARSHEET
